@* @model List<EscalasPascom.Models.Servo>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@{
    
    var mesSelecionado = ViewBag.MesSelecionado as int? ?? DateTime.Now.Month;
    var anoSelecionado = ViewBag.AnoSelecionado as int? ?? DateTime.Now.Year;

    int diasNoMes = DateTime.DaysInMonth(anoSelecionado, mesSelecionado);

    ViewData["Title"] = "Indisponibilidades";

    var meses = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames
        .Where(m => !string.IsNullOrEmpty(m))
        .Select((m, i) => new { Nome = m, Numero = i + 1 }).ToList();

    var anos = Enumerable.Range(DateTime.Now.Year - 2, 5).ToList();
}

<h2>Indisponibilidades</h2>

<form method="get" asp-action="Index" class="mb-3">
    <select name="mes" class="form-select d-inline w-auto">
        @for (int m = 1; m <= 12; m++)
        {
            <option value="@m" selected="@(m == ViewBag.MesSelecionado)">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            </option>
        }
    </select>
    <select name="ano" class="form-select d-inline w-auto">
        @for (int a = DateTime.Now.Year - 1; a <= DateTime.Now.Year + 1; a++)
        {
            <option value="@a" selected="@(a == ViewBag.AnoSelecionado)">@a</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Filtrar</button>
</form>

<form method="post" asp-action="SalvarIndisponibilidades">
    <input type="hidden" name="mes" value="@mesSelecionado" />
    <input type="hidden" name="ano" value="@anoSelecionado" />

    <div style="overflow-x:auto; max-height: 500px;">
        <table class="table table-bordered table-sm table-striped table-fixed-header">
            <thead>
                <tr>
                    <th rowspan="2">Pessoa</th>
                    @for (int d = 1; d <= diasNoMes; d++)
                    {
                        var data = new DateTime(anoSelecionado, mesSelecionado, d);
                        var classe = (data.DayOfWeek == DayOfWeek.Saturday || data.DayOfWeek == DayOfWeek.Sunday) ? "final-semana" : "";
                        <th class="@classe">@d</th>
                    }
                    <th rowspan="2">Ações</th>
                </tr>
                <tr>
                    @for (int d = 1; d <= diasNoMes; d++)
                    {
                        var data = new DateTime(anoSelecionado, mesSelecionado, d);
                        var classe = (data.DayOfWeek == DayOfWeek.Saturday || data.DayOfWeek == DayOfWeek.Sunday) ? "final-semana" : "";
                        var nomeDia = data.ToString("ddd", new System.Globalization.CultureInfo("pt-BR")).Substring(0, 3);
                        <th class="@classe">@nomeDia</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var pessoa in Model)
                {
                    <tr>
                        <td>@pessoa.Nome</td>
                        @for (int d = 1; d <= diasNoMes; d++)
                        {
                            var data = new DateTime(anoSelecionado, mesSelecionado, d);
                            var classe = (data.DayOfWeek == DayOfWeek.Saturday || data.DayOfWeek == DayOfWeek.Sunday) ? "final-semana" : "";
                            bool marcado = pessoa.Indisponibilidades.Any(i =>
                            i.Data.Year == anoSelecionado &&
                            i.Data.Month == mesSelecionado &&
                            i.Data.Day == d
                            );
                            <td class="text-center @classe">
                                <input type="checkbox"
                                       class="chk-@pessoa.Id"
                                       name="indisponibilidadesPorPessoa[@pessoa.Id][]"
                                       value="@d"
                                       @(marcado ? "checked" : "") />
                            </td>
                        }
                        <td>
                            <button type="button" class="btn btn-sm btn-success" onclick="marcarTudo(@pessoa.Id)">MarcarTudo</button>
                            <button type="button" class="btn btn-sm btn-info" onclick="marcarDiasDeSemana(@pessoa.Id)">Dias úteis</button>
                            <button type="button" class="btn btn-sm btn-warning" onclick="desmarcarTudo(@pessoa.Id)">Desm. tudo</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Salvar</button>
</form>

<script>
    function marcarTudo(id) {
        document.querySelectorAll(".chk-" + id).forEach(c => c.checked = true);
    }
    function desmarcarTudo(id) {
        document.querySelectorAll(".chk-" + id).forEach(c => c.checked = false);
    }
    function marcarDiasDeSemana(id) {
        const mes = document.querySelector('input[name="mes"]').value;
        const ano = document.querySelector('input[name="ano"]').value;

        document.querySelectorAll(".chk-" + id).forEach(c => {
            const dia = parseInt(c.value);
            const data = new Date(ano, mes - 1, dia); 
            const diaDaSemana = data.getDay();

            if (diaDaSemana >= 1 && diaDaSemana <= 5) {
                c.checked = true;
            } else {
                c.checked = false;
            }
        });
    }
</script>
<style>
    /* Linhas alternadas */
    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    /* Cabeçalho fixo */
    .table-fixed-header thead th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 2;
    }

    /* Estilo para fins de semana - Mais específico */
    .table-fixed-header thead th.final-semana,
    .table-fixed-header tbody td.final-semana {
        background-color: #e6f7ff; /* Cor azul claro para destacar */
        font-weight: bold;
    }

    .vertical-header {
        writing-mode: vertical-rl; /* Faz o texto ficar na vertical */
        transform: rotate(180deg); /* Gira o texto para que a leitura seja de baixo para cima */
        width: 25px; /* Define uma largura para a coluna */
        height: 80px; /* Define uma altura para a coluna */
        text-align: left; /* Alinha o texto na base */
        padding: 5px; /* Ajuste o espaçamento interno */
        white-space: nowrap; /* Evita quebra de linha extra */
    }

    .table-fixed-header thead th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 2;
        /* Adicione uma altura mínima para evitar sobreposição */
        min-height: 40px;
        box-sizing: border-box;
    }

    /* Para a segunda linha do cabeçalho */
    .table-fixed-header thead tr:nth-child(2) th {
        top: 25px; /* Ajuste este valor para a altura da primeira linha */
    }
</style> *@