@model List<Missa>

@{
    ViewBag.Title = "Escala de Missas";
    var mesSelecionado = ViewBag.MesSelecionado as int? ?? DateTime.Now.Month;
    var anoSelecionado = ViewBag.AnoSelecionado as int? ?? DateTime.Now.Year;
    var meses = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames
        .Where(m => !string.IsNullOrEmpty(m))
        .Select((m, i) => new { Nome = m, Numero = i + 1 }).ToList();

    var anos = Enumerable.Range(DateTime.Now.Year - 2, 5).ToList();

    int diasNoMes = DateTime.DaysInMonth(anoSelecionado, mesSelecionado);
    bool sorteado = ViewBag.Sorteado ?? false;
}

<h2>Escala de Missas</h2>

<form method="get" asp-action="Index" class="mb-3">
    <select name="mes" class="form-select d-inline w-auto">
        @for (int m = 1; m <= 12; m++)
        {
            <option value="@m" selected="@(m == ViewBag.MesSelecionado)">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            </option>
        }
    </select>
    <select name="ano" class="form-select d-inline w-auto">
        @for (int a = DateTime.Now.Year - 1; a <= DateTime.Now.Year + 1; a++)
        {
            <option value="@a" selected="@(a == ViewBag.AnoSelecionado)">@a</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Filtrar</button>
</form>


<form method="post" asp-action="Sortear">
    <input type="hidden" name="mes" value="@mesSelecionado" />
    <input type="hidden" name="ano" value="@anoSelecionado" />

    @if (!sorteado)
    {
        <button type="submit" class="btn btn-success mb-3">
            Sortear Escala
        </button>
    }
    else
    {
        <div class="alert alert-info mb-3">
            A escala de <b>@meses.First(m => m.Numero == mesSelecionado).Nome/@anoSelecionado</b> já foi sorteada.
        </div>
    }
</form>
<form method="get" asp-action="ExportarEscala">
    <input type="hidden" name="mes" value="@mesSelecionado" />
    <input type="hidden" name="ano" value="@anoSelecionado" />
    <button type="submit" class="btn btn-success mb-3">
        Exportar escalas para PDF
    </button>
</form>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Data</th>
            <th>Dia da Semana</th>
            <th>Local</th>
            <th>Operador</th>
            <th>Câmera/Som</th>
            <th>Mídia</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var missa in Model)
        {
            var operadores = missa.Escalados
                .Where(e => e.Papel?.Descricao == "Operador")
                .Select(e => e.Pessoa.Nome)
                .ToList();

            var fotografos = missa.Escalados
                .Where(e => e.Papel?.Descricao == "Foto/Som")
                .Select(e => e.Pessoa.Nome)
                .ToList();

            var midias = missa.Escalados
                .Where(e => e.Papel?.Descricao == "Mídia")
                .Select(e => e.Pessoa.Nome)
                .ToList();

            <tr>
                <td>@missa.Data.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var data = new DateTime(ViewBag.AnoSelecionado, ViewBag.MesSelecionado, missa.Data.Day);
                        var diaSemana = data.ToString("dddd", System.Globalization.CultureInfo.CurrentCulture).ToUpper();
                    }
                    <span>@diaSemana</span>
                </td>
                <td>@missa.Local?.Nome</td>
                <td>@string.Join(", ", operadores)</td>
                <td>@string.Join(", ", fotografos)</td>
                <td>@string.Join(", ", midias)</td>
            </tr>
        }
    </tbody>
</table>
